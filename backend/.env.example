# ---- Server ----
NODE_ENV=development
PORT=5000

# ---- Database ----
# MongoDB Atlas (replica set built in, recommended):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/stockify_pos?retryWrites=true&w=majority
# Local single-node replica set (see README / Phase 1 notes):
MONGODB_URI=mongodb://127.0.0.1:27017/stockify_pos?replicaSet=rs0

# ---- Authentication ----
# Generate with: node -p "require('crypto').randomBytes(48).toString('hex')"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-characters
JWT_EXPIRES_IN=1d
BCRYPT_SALT_ROUNDS=12

# ---- Frontend origin (CORS) ----
CLIENT_URL=http://localhost:3000

# ---- Business timezone ----
# Offset from UTC in minutes. Bangladesh (UTC+6) = 360. Used for "today", "this week", reports.
BUSINESS_UTC_OFFSET_MINUTES=360